# Supabase: Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay: Dashboard in Test mode, Account & Settings, API keys. Use rzp_test_ keys only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Optional: Razorpay webhook secret (event payment.captured) as a backup credit path.
RAZORPAY_WEBHOOK_SECRET=

# The Still extension's ID, so its requests are allowed.
EXTENSION_ID=hjcpkhjkanikiahcjmhcblnnkloopnmc
